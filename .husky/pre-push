#!/usr/bin/env sh
# Two checks run on every push, in this order: the changelog fragment check, then the gate.
#
# 1. Skip everything when every pushed commit changes only record paths (RECORD_PATHS in
#    scripts/config/gate.sh: task files, reports, BACKLOG.md, LESSONS.md, plans), as
#    `task.py new` does on each filing. Tooling code under .agents/tasks/scripts/ and the
#    process docs are not records, so they run the gate. Files are listed per commit, so a
#    change that a later commit reverts still counts. Anything else runs the gate: a file
#    outside RECORD_PATHS (including one renamed into it, hence --no-renames), a new remote
#    branch, or a range git cannot list. A merge commit lists its files against its first
#    parent (--diff-merges=first-parent), so a change made only inside a merge counts.
#
# 2. For each pushed ref, run `scripts/changelog.py check`, which fails when a feat, fix or
#    breaking commit in the range adds no changelog fragment, or a fragment is invalid. The
#    branch comes from remote_ref, never local_ref, which can be HEAD. The remote is the one
#    git passes as $1 (origin when run by hand). The range is:
#      - main and develop: <remote_sha>..<local_sha>; a first push of either (all-zero
#        remote_sha) is not checked;
#      - hotfix/*: merge base with refs/remotes/<remote>/main to the tip;
#      - any other branch, new or not: merge base with refs/remotes/<remote>/develop to the tip.
#    Deleted refs, tags and any non-branch ref are skipped. When the range cannot be listed
#    (changelog.py exits 2, the merge base fails, or that remote-tracking ref is missing, as
#    when $1 is a URL), the fragment check is skipped for that ref and the gate still runs.
#    Branch names come from scripts/config/gate.sh.
#
#    Exit status of changelog.py: 0 passes; 1 is a missing or invalid fragment and rejects the
#    push with that explanation; 2 skips as above; anything else (3 is an internal error, 127
#    a missing python3, a signal) rejects the push with "changelog check failed (exit N)" and
#    no claim about a missing fragment.
#
# A failed fragment check rejects the push before the gate starts.
#
# The gate depends on the ref. A push of develop or main runs `scripts/gate.sh --if-needed`
# with every pushed, non-deleted local sha: the full gate runs only for a commit whose code
# has no gate record that suffices. The slow tests are skipped only for a change that is
# safe-list-only (SLOW_SAFE_PATHS in scripts/config/gate.sh), and a push to main always needs
# them: main's shas go in a separate `--if-needed --all` call, made first, and develop's shas
# in another. When the push has any other branch ref (a task branch), one `scripts/gate.sh
# --fast` call runs as well; the independent verifier's full run follows before a merge. Tags
# and other non-branch refs trigger no gate.
# shellcheck disable=SC1091
. scripts/config/gate.sh

remote=${1:-origin}
refs=$(cat)

# Every RECORD_PATHS entry becomes a `:(exclude,glob)<entry>` pathspec in "$@", the same
# matcher gate.sh uses for the key of a gate record. Globbing is off while the string is split.
# $1 is saved above, so "$@" is free for the list.
set --
set -f
for entry in $RECORD_PATHS; do
  set -- "$@" ":(exclude,glob)$entry"
done
set +f

tasks_only=1
while read -r local_ref local_sha remote_ref remote_sha; do
  # A deleted ref (all-zero local sha) pushes no commits.
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  # A new remote branch (all-zero remote sha) has no base to diff against.
  case "$remote_sha" in *[!0]*) ;; *) tasks_only=0; break ;; esac
  # --full-history keeps history simplification from hiding a commit of a merged side branch.
  # What git prints is every path outside RECORD_PATHS that a commit of the range changes.
  if ! changed=$(git log --format= --name-only --no-renames --diff-merges=first-parent --full-history "$remote_sha..$local_sha" -- . "$@" 2>/dev/null); then
    tasks_only=0
    break
  fi
  if [ -n "$changed" ]; then
    tasks_only=0
    break
  fi
done <<EOF
$refs
EOF

if [ "$tasks_only" = 1 ]; then
  echo "pre-push: only record paths changed; skipping gate."
  exit 0
fi

fragment_failed=0
check_failed=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  tracking=""
  base=""
  case "$remote_ref" in
    "refs/heads/$MAIN_BRANCH" | "refs/heads/$DEVELOP_BRANCH")
      case "$remote_sha" in *[!0]*) base=$remote_sha ;; *) continue ;; esac
      ;;
    refs/heads/hotfix/*)
      tracking="$remote/$MAIN_BRANCH"
      base=$(git merge-base "refs/remotes/$tracking" "$local_sha" 2>/dev/null) || base=""
      ;;
    refs/heads/*)
      tracking="$remote/$DEVELOP_BRANCH"
      base=$(git merge-base "refs/remotes/$tracking" "$local_sha" 2>/dev/null) || base=""
      ;;
    *) continue ;;
  esac
  if [ -z "$base" ]; then
    echo "pre-push: no merge base with $tracking for $remote_ref; skipping the changelog check." >&2
    continue
  fi
  rc=0
  python3 scripts/changelog.py check "$base" "$local_sha" || rc=$?
  case "$rc" in
    0) ;;
    1) fragment_failed=1 ;;
    2) echo "pre-push: cannot list $base..$local_sha for $remote_ref; skipping the changelog check." >&2 ;;
    *)
      echo "pre-push: changelog check failed (exit $rc) for $remote_ref" >&2
      check_failed=1
      ;;
  esac
done <<EOF
$refs
EOF

if [ "$fragment_failed" = 1 ]; then
  echo "pre-push: push rejected, a range has feat, fix or breaking commits without a changelog fragment, or an invalid fragment." >&2
fi
if [ "$fragment_failed" = 1 ] || [ "$check_failed" = 1 ]; then
  exit 1
fi

# develop and main need a gate record for every pushed commit; any other branch runs --fast.
# The shas go in as the "--if-needed" argument lists; no sha contains a space. A record of a run
# without the slow tests never satisfies main, so main's call passes --all.
main_needed=""
needed=""
fast=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  case "$remote_ref" in
    "refs/heads/$MAIN_BRANCH") main_needed="$main_needed $local_sha" ;;
    "refs/heads/$DEVELOP_BRANCH") needed="$needed $local_sha" ;;
    refs/heads/*) fast=1 ;;
    *) ;;
  esac
done <<EOF
$refs
EOF

if [ "$fast" = 1 ]; then
  scripts/gate.sh --fast || exit 1
fi
if [ -n "$main_needed" ]; then
  # shellcheck disable=SC2086
  scripts/gate.sh --if-needed --all $main_needed || exit 1
fi
if [ -n "$needed" ]; then
  # shellcheck disable=SC2086
  scripts/gate.sh --if-needed $needed || exit 1
fi
exit 0
